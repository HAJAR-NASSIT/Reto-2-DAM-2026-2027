        <mxCell id="BOBEnok9XB9euXxJZHLD-63" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=light-dark(transparent,#007FFF);perimeterSpacing=0;arcSize=21;" value="&lt;ul data-start=&quot;942&quot; data-end=&quot;1435&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-start=&quot;942&quot; data-end=&quot;1035&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;944&quot; data-end=&quot;1035&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-start=&quot;944&quot; data-end=&quot;968&quot;&gt;CLIENTE 1 → N COMPRA&lt;/strong&gt;&lt;br data-start=&quot;968&quot; data-end=&quot;971&quot;&gt;&lt;br&gt;La PK de &lt;strong data-start=&quot;982&quot; data-end=&quot;993&quot;&gt;CLIENTE&lt;/strong&gt; (&lt;code data-start=&quot;995&quot; data-end=&quot;1000&quot;&gt;DNI&lt;/code&gt;) se propaga como FK en &lt;strong data-start=&quot;1024&quot; data-end=&quot;1034&quot;&gt;COMPRA&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-start=&quot;1037&quot; data-end=&quot;1136&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1039&quot; data-end=&quot;1136&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-start=&quot;1039&quot; data-end=&quot;1063&quot;&gt;COMPRA 1 → N ENTRADA&lt;/strong&gt;&lt;br data-start=&quot;1063&quot; data-end=&quot;1066&quot;&gt;&lt;br&gt;La PK de &lt;strong data-start=&quot;1077&quot; data-end=&quot;1087&quot;&gt;COMPRA&lt;/strong&gt; (&lt;code data-start=&quot;1089&quot; data-end=&quot;1100&quot;&gt;id_compra&lt;/code&gt;) se propaga como FK en &lt;strong data-start=&quot;1124&quot; data-end=&quot;1135&quot;&gt;ENTRADA&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-start=&quot;1138&quot; data-end=&quot;1237&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1140&quot; data-end=&quot;1237&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-start=&quot;1140&quot; data-end=&quot;1164&quot;&gt;SESION 1 → N ENTRADA&lt;/strong&gt;&lt;br data-start=&quot;1164&quot; data-end=&quot;1167&quot;&gt;&lt;br&gt;La PK de &lt;strong data-start=&quot;1178&quot; data-end=&quot;1188&quot;&gt;SESION&lt;/strong&gt; (&lt;code data-start=&quot;1190&quot; data-end=&quot;1201&quot;&gt;id_sesion&lt;/code&gt;) se propaga como FK en &lt;strong data-start=&quot;1225&quot; data-end=&quot;1236&quot;&gt;ENTRADA&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-start=&quot;1239&quot; data-end=&quot;1342&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1241&quot; data-end=&quot;1342&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-start=&quot;1241&quot; data-end=&quot;1266&quot;&gt;PELÍCULA 1 → N SESION&lt;/strong&gt;&lt;br data-start=&quot;1266&quot; data-end=&quot;1269&quot;&gt;&lt;br&gt;La PK de &lt;strong data-start=&quot;1280&quot; data-end=&quot;1292&quot;&gt;PELÍCULA&lt;/strong&gt; (&lt;code data-start=&quot;1294&quot; data-end=&quot;1307&quot;&gt;id_pelicula&lt;/code&gt;) se propaga como FK en &lt;strong data-start=&quot;1331&quot; data-end=&quot;1341&quot;&gt;SESION&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-start=&quot;1344&quot; data-end=&quot;1435&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1346&quot; data-end=&quot;1435&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-start=&quot;1346&quot; data-end=&quot;1367&quot;&gt;SALA 1 → N SESION&lt;/strong&gt;&lt;br data-start=&quot;1367&quot; data-end=&quot;1370&quot;&gt;&lt;br&gt;La PK de &lt;strong data-start=&quot;1381&quot; data-end=&quot;1389&quot;&gt;SALA&lt;/strong&gt; (&lt;code data-start=&quot;1391&quot; data-end=&quot;1400&quot;&gt;id_sala&lt;/code&gt;) se propaga como FK en &lt;strong data-start=&quot;1424&quot; data-end=&quot;1434&quot;&gt;SESION&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1344&quot; data-end=&quot;1435&quot;&gt;&lt;p data-start=&quot;1346&quot; data-end=&quot;1435&quot;&gt;&lt;strong data-start=&quot;1346&quot; data-end=&quot;1367&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: medium;&quot;&gt;GENERO&lt;/strong&gt;&lt;strong data-start=&quot;1346&quot; data-end=&quot;1367&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: medium;&quot;&gt;&lt;strong data-start=&quot;1241&quot; data-end=&quot;1266&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1&lt;/strong&gt;→ N&amp;nbsp;&lt;/strong&gt;&lt;strong data-start=&quot;1346&quot; data-end=&quot;1367&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: medium;&quot;&gt;&lt;strong data-start=&quot;1241&quot; data-end=&quot;1266&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;PELÍCULA&lt;/strong&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;ul data-start=&quot;942&quot; data-end=&quot;1435&quot;&gt;&lt;li data-start=&quot;1344&quot; data-end=&quot;1435&quot;&gt;&lt;p data-start=&quot;1346&quot; data-end=&quot;1435&quot;&gt;&lt;font size=&quot;3&quot;&gt;La PK de&amp;nbsp;&lt;strong data-start=&quot;1381&quot; data-end=&quot;1389&quot;&gt;genero&lt;/strong&gt;&amp;nbsp;(&lt;code data-start=&quot;1391&quot; data-end=&quot;1400&quot;&gt;nombre&lt;/code&gt;) se propaga como FK en&amp;nbsp;&lt;b&gt;Pelicula&lt;/b&gt;.&lt
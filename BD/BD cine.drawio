        <mxCell id="pkIK3N6LH4eTFHhO8l7c-49" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=light-dark(transparent,#3399FF);" value="&lt;li data-start=&quot;710&quot; data-end=&quot;828&quot;&gt;&lt;p data-start=&quot;249&quot; data-end=&quot;277&quot;&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;279&quot; data-end=&quot;377&quot;&gt;&lt;li data-start=&quot;279&quot; data-end=&quot;325&quot;&gt;&lt;p data-start=&quot;281&quot; data-end=&quot;325&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Un cliente &lt;span data-start=&quot;292&quot; data-end=&quot;303&quot;&gt;realiza&lt;/span&gt; una o varias compras.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;326&quot; data-end=&quot;377&quot;&gt;&lt;p data-start=&quot;328&quot; data-end=&quot;377&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una compra &lt;span data-start=&quot;339&quot; data-end=&quot;359&quot;&gt;es realizada por&lt;/span&gt; un único cliente.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-start=&quot;434&quot; data-end=&quot;457&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/h3&gt;&lt;ul data-start=&quot;701&quot; data-end=&quot;795&quot;&gt;&lt;li data-start=&quot;488&quot; data-end=&quot;535&quot;&gt;&lt;p data-start=&quot;490&quot; data-end=&quot;535&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una compra &lt;span data-start=&quot;501&quot; data-end=&quot;512&quot;&gt;incluye&lt;/span&gt; una o varias entradas.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;536&quot; data-end=&quot;583&quot;&gt;&lt;p data-start=&quot;538&quot; data-end=&quot;583&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una entrada &lt;span data-start=&quot;550&quot; data-end=&quot;565&quot;&gt;pertenece a&lt;/span&gt; una única compra.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;536&quot; data-end=&quot;583&quot;&gt;&lt;p data-start=&quot;538&quot; data-end=&quot;583&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;536&quot; data-end=&quot;583&quot;&gt;&lt;p data-start=&quot;538&quot; data-end=&quot;583&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Una entrada &lt;/span&gt;&lt;span data-start=&quot;715&quot; data-end=&quot;732&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;corresponde a&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; una sola sesión.&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;750&quot; data-end=&quot;795&quot;&gt;&lt;p data-start=&quot;752&quot; data-end=&quot;795&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una sesión &lt;span data-start=&quot;763&quot; data-end=&quot;778&quot;&gt;puede tener&lt;/span&gt; muchas entradas.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;877&quot; data-end=&quot;913&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;915&quot; data-end=&quot;1017&quot;&gt;&lt;li data-start=&quot;915&quot; data-end=&quot;971&quot;&gt;&lt;p data-start=&quot;917&quot; data-end=&quot;971&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una película &lt;span data-start=&quot;930&quot; data-end=&quot;948&quot;&gt;se proyecta en&lt;/span&gt; una o varias sesiones.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;972&quot; data-end=&quot;1017&quot;&gt;&lt;p data-start=&quot;974&quot; data-end=&quot;1017&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una sesión &lt;span data-start=&quot;985&quot; data-end=&quot;997&quot;&gt;proyecta&lt;/span&gt; una única película.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1096&quot; data-end=&quot;1119&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;1121&quot; data-end=&quot;1205&quot;&gt;&lt;li data-start=&quot;1121&quot; data-end=&quot;1158&quot;&gt;&lt;p data-start=&quot;1123&quot; data-end=&quot;1158&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una sala &lt;span data-start=&quot;1132&quot; data-end=&quot;1141&quot;&gt;acoge&lt;/span&gt; varias sesiones.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1159&quot; data-end=&quot;1205&quot;&gt;&lt;p data-start=&quot;1161&quot; data-end=&quot;1205&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Una sesión &lt;span data-start=&quot;1172&quot; data-end=&quot;1190&quot;&gt;tiene lugar en&lt;/span&gt; una sola sala.&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" vertex="1">
